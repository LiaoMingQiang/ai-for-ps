{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "majicmix_realistic_v7.safetensors"
    },
    "_meta": {
      "title": "基础模型"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": {
      "title": "输入图"
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "seed": 0,
      "steps": 16,
      "cfg": 6,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "denoise": 0.25
    },
    "_meta": {
      "title": "采样器"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "sharp details, clean edges, high resolution photograph",
      "clip": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "正向提示词"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "lowres, blurry, jpeg artifacts, watermark, text, logo, deformed, extra limbs, oversharpened, halo artifacts",
      "clip": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "Negative 负向提示词"
    }
  },
  "6": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "20",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "编码"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "3",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "解码"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "psai/wf.upscale.general"
    },
    "_meta": {
      "title": "输出"
    }
  },
  "20": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": [
        "22",
        0
      ],
      "upscale_method": "lanczos",
      "scale_by": 0.5
    },
    "_meta": {
      "title": "缩到目标倍数（factor ÷ 4）"
    }
  },
  "21": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    },
    "_meta": {
      "title": "超分模型"
    }
  },
  "22": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "21",
        0
      ],
      "image": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "超分放大（4×）"
    }
  }
}