{
  "manifestVersion": 5,
  "id": "com.aiforps.plugin.ai",
  "name": "AI for PS",
  "version": "0.9.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiForPsPanel",
      "label": {
        "default": "AI for PS"
      },
      "minimumSize": { "width": 320, "height": 240 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 460, "height": 720 },
      "preferredFloatingSize": { "width": 1180, "height": 800 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/icon-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    },
    {
      "type": "command",
      "id": "openMainPanel",
      "label": {
        "default": "打开 AI for PS"
      }
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon-dark.png", "scale": [1, 2], "theme": ["dark", "darkest"] },
    { "width": 23, "height": 23, "path": "icons/icon-light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1",
        "http://localhost",
        "ws://127.0.0.1",
        "ws://localhost"
      ]
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "request"
  }
}
